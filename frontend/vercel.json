{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "serastore.in"
        }
      ],
      "destination": "https://www.serastore.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Pinterest|bot|Bot|Crawler|Spider).*"
        }
      ],
      "destination": "https://backend.serastore.in/api/products/share/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}