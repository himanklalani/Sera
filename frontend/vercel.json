{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "serastore.in"
        }
      ],
      "destination": "https://www.serastore.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://backend.serastore.in/sitemap.xml"
    },
    {
      "source": "/journal/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Pinterest|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "https://backend.serastore.in/api/blogs/share/:slug"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:StoreBot-Google|AdsBot-Google).*"
        }
      ],
      "destination": "https://backend.serastore.in/api/products/merchant/:id"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Pinterest|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "https://backend.serastore.in/api/products/share/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}